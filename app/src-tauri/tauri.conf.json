{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archiver",
  "version": "0.42.7",
  "identifier": "app.archiver.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Archiver",
        "width": 1320,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active"
        },
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' asset: http://asset.localhost ipc: http://ipc.localhost https://azaslhrsoziwasehynoe.supabase.co; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.graphics-design",
    "resources": {
      "demo/": "demo/"
    },
    "copyright": "© 2026 Lukas Rudolph",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "contentTypes": [
          "public.jpeg"
        ],
        "name": "JPEG",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "png"
        ],
        "contentTypes": [
          "public.png"
        ],
        "name": "PNG",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "gif"
        ],
        "contentTypes": [
          "com.compuserve.gif"
        ],
        "name": "GIF",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "webp"
        ],
        "contentTypes": [
          "org.webmproject.webp"
        ],
        "name": "WebP",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "contentTypes": [
          "public.tiff"
        ],
        "name": "TIFF",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "heic",
          "heif"
        ],
        "contentTypes": [
          "public.heic",
          "public.heif"
        ],
        "name": "HEIC",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "avif"
        ],
