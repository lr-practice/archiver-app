        "contentTypes": [
          "public.aiff-audio",
          "public.aifc-audio"
        ],
        "name": "AIFF",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "m4a"
        ],
        "contentTypes": [
          "com.apple.m4a-audio"
        ],
        "name": "MPEG-4 Audio",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "flac"
        ],
        "contentTypes": [
          "org.xiph.flac"
        ],
        "name": "FLAC",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwRjdCRTQ2QzEyMDM3Q0QKUldUTk55REJScjczd01Fbkk3YWl3SHZNYzRXMUN4U2l1MFh2RWdMTkFMcFhuUUJOSG5EOTJ2ME8K",
      "endpoints": [
        "https://github.com/lr-practice/Archiver-Releases/releases/latest/download/latest.json"
      ]
    }
  }
}
